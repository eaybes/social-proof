{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "social-proof/signature",
	"title": "Social Proof",
	"category": "widgets",
	"icon": "groups",
	"description": "מציג את שלוש החתימות האחרונות על עצומה (Gravity Forms) בסבב מתחלף, לבניית אמון חברתי בעמוד.",
	"keywords": [ "social proof", "עצומה", "חתימות", "gravity forms", "petition" ],
	"textdomain": "social-proof",
	"attributes": {
		"formId": { "type": "number", "default": 0 },
		"template": { "type": "string", "default": "" },
		"language": { "type": "string", "default": "he" },
		"align": { "type": "string", "default": "right" },
		"textColor": { "type": "string", "default": "" },
		"backgroundType": { "type": "string", "default": "solid" },
		"backgroundColor": { "type": "string", "default": "#f0f0f0" },
		"gradientColor1": { "type": "string", "default": "#1d9e75" },
		"gradientColor2": { "type": "string", "default": "#0693e3" },
		"gradientAngle": { "type": "number", "default": 135 },
		"animationStyle": { "type": "string", "default": "fade" },
		"fixedTimestamps": { "type": "boolean", "default": false }
	},
	"supports": {
		"html": false,
		"align": false,
		"color": false
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php"
}
